		{
			"name": "Loteamentos e Lotes",
			"item": [
				{
					"name": "Criar Loteamento",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('loteamento_id', body.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Residencial Sol Nascente\",\n  \"descricao\": \"Fase 1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/loteamentos",
							"host": ["{{base_url}}"],
							"path": ["loteamentos"]
						},
						"description": "O id criado é salvo automaticamente na variável `loteamento_id`."
					},
					"response": []
				},
				{
					"name": "Listar Loteamentos",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/loteamentos",
							"host": ["{{base_url}}"],
							"path": ["loteamentos"]
						}
					},
					"response": []
				},
				{
					"name": "Obter Loteamento",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/loteamentos/{{loteamento_id}}",
							"host": ["{{base_url}}"],
							"path": ["loteamentos", "{{loteamento_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Atualizar Loteamento",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"descricao\": \"Fase 1 - atualizado\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/loteamentos/{{loteamento_id}}",
							"host": ["{{base_url}}"],
							"path": ["loteamentos", "{{loteamento_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Remover Loteamento",
					"request": {
						"method": "DELETE",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/loteamentos/{{loteamento_id}}",
							"host": ["{{base_url}}"],
							"path": ["loteamentos", "{{loteamento_id}}"]
						},
						"description": "Remoção lógica (soft-delete) — não é hard-delete."
					},
					"response": []
				},
				{
					"name": "Criar Lote",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('lote_id', body.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identificacao\": \"Lote 01\",\n  \"quadra\": \"A\",\n  \"area_m2\": \"300.00\",\n  \"preco\": \"120000.00\",\n  \"caracteristicas\": {\"esquina\": true}\n}"
						},
						"url": {
							"raw": "{{base_url}}/loteamentos/{{loteamento_id}}/lotes",
							"host": ["{{base_url}}"],
							"path": ["loteamentos", "{{loteamento_id}}", "lotes"]
						},
						"description": "Nasce sempre com status \"disponivel\". O id criado é salvo automaticamente na variável `lote_id`."
					},
					"response": []
				},
				{
					"name": "Listar Lotes do Loteamento",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/loteamentos/{{loteamento_id}}/lotes",
							"host": ["{{base_url}}"],
							"path": ["loteamentos", "{{loteamento_id}}", "lotes"]
						}
					},
					"response": []
				},
				{
					"name": "Obter Lote",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/lotes/{{lote_id}}",
							"host": ["{{base_url}}"],
							"path": ["lotes", "{{lote_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Atualizar Lote",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"preco\": \"135000.00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/lotes/{{lote_id}}",
							"host": ["{{base_url}}"],
							"path": ["lotes", "{{lote_id}}"]
						},
						"description": "Atualiza campos gerais do lote. O status NÃO é editável por aqui — use 'Transicionar Status do Lote'."
					},
					"response": []
				},
				{
					"name": "Transicionar Status do Lote",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"reservado\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/lotes/{{lote_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["lotes", "{{lote_id}}", "status"]
						},
						"description": "Valores possíveis: disponivel, reservado, vendido, indisponivel. Transições permitidas: DISPONIVEL -> RESERVADO/INDISPONIVEL; RESERVADO -> VENDIDO/DISPONIVEL; INDISPONIVEL -> DISPONIVEL; VENDIDO é terminal. Uma transição fora dessa tabela retorna 409 com mensagem explicando o motivo."
					},
					"response": []
				},
				{
					"name": "Remover Lote",
					"request": {
						"method": "DELETE",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/lotes/{{lote_id}}",
							"host": ["{{base_url}}"],
							"path": ["lotes", "{{lote_id}}"]
						},
						"description": "Remoção lógica (soft-delete) — não é hard-delete."
					},
					"response": []
				}
			]
		}
	]
