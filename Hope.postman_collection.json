{
	"info": {
		"name": "Hope",
		"description": "Coleção Postman das rotas expostas pela API do Hope (backend FastAPI). Atualize esta coleção sempre que uma rota for adicionada, alterada ou removida — ver CLAUDE.md.\n\nVariáveis usadas:\n- base_url: URL base da API (default http://localhost:8000)\n- access_token: preenchido automaticamente pelo teste do request de Login\n- loteamento_id / lote_id: preenchidos automaticamente pelos requests de criação correspondentes",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "loteamento_id",
			"value": ""
		},
		{
			"key": "lote_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Identity",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('access_token', body.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"senha123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Autentica com email/senha e retorna um JWT (access_token). O token é salvo automaticamente na variável de coleção `access_token` para uso nos demais requests."
					},
					"response": []
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						},
						"description": "Retorna o usuário autenticado e seu tenant atual. Requer rodar 'Login' antes (ou definir manualmente a variável access_token)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Clientes",
			"item": [
				{
					"name": "Criar Cliente",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"João da Silva\",\n  \"documento\": \"123.456.789-00\",\n  \"contato\": \"joao@email.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/clientes",
							"host": ["{{base_url}}"],
							"path": ["clientes"]
						}
					},
					"response": []
				},
				{
					"name": "Listar Clientes",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/clientes",
							"host": ["{{base_url}}"],
							"path": ["clientes"]
						}
					},
					"response": []
				},
				{
					"name": "Obter Cliente",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/clientes/:cliente_id",
							"host": ["{{base_url}}"],
							"path": ["clientes", ":cliente_id"],
							"variable": [{"key": "cliente_id", "value": ""}]
						}
					},
					"response": []
				},
				{
					"name": "Atualizar Cliente",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"contato\": \"novo-contato@email.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/clientes/:cliente_id",
							"host": ["{{base_url}}"],
							"path": ["clientes", ":cliente_id"],
							"variable": [{"key": "cliente_id", "value": ""}]
						}
					},
					"response": []
				},
				{
					"name": "Remover Cliente",
					"request": {
						"method": "DELETE",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"url": {
							"raw": "{{base_url}}/clientes/:cliente_id",
							"host": ["{{base_url}}"],
							"path": ["clientes", ":cliente_id"],
							"variable": [{"key": "cliente_id", "value": ""}]
						},
						"description": "Remoção lógica (soft-delete) — não é hard-delete."
					},
					"response": []
				}
			]
		},
