DATABASE_URL=postgresql+asyncpg://lotiado_app:lotiado_app@localhost:5432/lotiado
TEST_DATABASE_URL=postgresql+asyncpg://lotiado:lotiado@localhost:5432/lotiado_test
# Usada só por `alembic upgrade` (make migrate): precisa ser dona das tabelas
# para poder rodar ALTER TABLE ... ENABLE/FORCE ROW LEVEL SECURITY e CREATE
# POLICY. `lotiado_app` (acima) não tem esse privilégio de propósito — ver
# infra/postgres/init/03-create-app-role.sql.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://lotiado:lotiado@localhost:5432/lotiado
ENVIRONMENT=development
DEBUG=true
